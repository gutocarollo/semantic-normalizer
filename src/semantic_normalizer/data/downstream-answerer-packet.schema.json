{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cga-game.local/schemas/downstream-answerer-packet-v2.schema.json",
  "title": "Masked downstream answerer packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "question", "snippets", "output_contract"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^Q[0-9]{3}$"},
    "question": {"type": "string", "minLength": 1},
    "snippets": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/snippet"}
    },
    "output_contract": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snippet_id", "text"],
      "properties": {
        "snippet_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
