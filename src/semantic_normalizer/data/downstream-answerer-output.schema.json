{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cga-game.local/schemas/downstream-answerer-output-v2.schema.json",
  "title": "Downstream answerer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "answer", "claims", "abstained"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^Q[0-9]{3}$"},
    "answer": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "abstained": {"type": "boolean"}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citations"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{2}$"}
        }
      }
    }
  }
}
