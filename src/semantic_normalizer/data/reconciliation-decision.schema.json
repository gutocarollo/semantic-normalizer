{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cga-game.local/schemas/semantic-normalizer-reconciliation-decision-v1.schema.json",
  "title": "Append-only Reconciliation Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_version", "decision_id", "request_id", "occurrence_id",
    "registry_version", "registry_sha256", "registry_schema_sha256",
    "input_sha256", "request_sha256", "response_sha256", "reviewer",
    "timestamp", "rationale", "protected_slot_comparison", "attempt", "result"
  ],
  "properties": {
    "decision_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "pattern": "^dec-[a-f0-9]{64}$"},
    "request_id": {"type": "string", "pattern": "^req-[a-f0-9]{64}$"},
    "occurrence_id": {"type": "string", "pattern": "^occ-[a-f0-9]{64}$"},
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "registry_schema_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "response_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "protected_slot_comparison": {
      "enum": ["preserved", "changed", "not-applicable"]
    },
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "attempts", "candidate_id", "reason_code", "confidence",
        "evidence_span", "transition_trace"
      ],
      "properties": {
        "state": {"enum": ["accepted", "unresolved", "review", "rejected"]},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 2},
        "candidate_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "reason_code": {
          "enum": [
            "EXACT_APPROVED_FORM", "CONTEXT_DISAMBIGUATED",
            "INSUFFICIENT_CONTEXT", "NO_ALLOWED_CANDIDATE",
            "CONFLICTING_EVIDENCE"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_span": {"$ref": "#/$defs/span"},
        "transition_trace": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "text"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
