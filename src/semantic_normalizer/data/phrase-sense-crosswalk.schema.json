{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cga-game.local/schemas/phrase-sense-crosswalk-v1.schema.json",
  "title": "Post-freeze blind phrase sense crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_sha256",
    "catalog_sha256",
    "registry_sha256",
    "created_after_freeze",
    "blindness",
    "mappings"
  ],
  "properties": {
    "schema_version": {"const": "phrase-sense-crosswalk-v1"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "created_after_freeze": {"const": true},
    "blindness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_seen",
        "predictions_seen",
        "registry_policies_seen"
      ],
      "properties": {
        "text_seen": {"const": false},
        "predictions_seen": {"const": false},
        "registry_policies_seen": {"const": false}
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mapping"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "senseId": {
      "type": "string",
      "pattern": "^s_[a-f0-9]{8,32}$"
    },
    "target": {
      "type": "string",
      "pattern": "^(?:NO_CONCEPT|UNCERTAIN|[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*)$"
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense_id", "target"],
      "properties": {
        "sense_id": {"$ref": "#/$defs/senseId"},
        "target": {"$ref": "#/$defs/target"}
      }
    }
  }
}
